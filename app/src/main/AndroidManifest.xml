<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- IZINLER
         INTERNET: Google Play Games girisi ve bulut kayit icin GEREKLI.
                   Oyunun kendisi cevrimdisi calisir. Ag sadece Play Games
                   icin kullanilir. WebView'in ag erisimi KAPALIDIR
                   (bkz. MainActivity: her istek engellenir).
         ACCESS_NETWORK_STATE: Play Games baglanti durumunu kontrol eder. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- D-107: Google Play Faturalandirma. Tek seferlik satin alma icin. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <application
        android:name=".PrismioApp"
        android:label="Prismio"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/PrismioTheme"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:backupInForeground="false"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:supportsRtl="false">

        <!-- =================================================================
             ADMOB  (D-129)

             DIKKAT - BU SATIR ZORUNLU:
             play-services-ads SDK'si acilista kendi saglayicisini calistirir
             ve APPLICATION_ID meta-data'sini ARAR. Yoksa uygulama ACILISTA
             COKER. Reklam kullanmasak bile bu satir bulunmali.

             Simdilik Google'in RESMI TEST kimligi yazili. Boylece:
               - uygulama cokmez
               - gercek reklam istenmez (Reklam.java'daki BIRIM_ID bos)

             YAYINDAN ONCE: kendi AdMob uygulama kimliginle DEGISTIR.
             Test kimligiyle yayina cikmak AdMob hesabini askiya aldirir.

             DELAY_APP_MEASUREMENT_INIT: olcum/veri toplama, biz
             MobileAds.initialize() cagirana kadar BASLAMAZ. Reklam
             kapaliyken hicbir veri toplanmaz - Play "Veri guvenligi"
             beyaniyla tutarli kalir.
             ================================================================= -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <!-- Google Play Games Services proje kimligi.
             Play Console'da oyun olusturunca verilen sayi buraya yazilir. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout|density"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
